#!/bin/sh
set -eu
RUNTIME_DIR=$(CDPATH='' cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)
RVC_DATA_DIR=$(dirname -- "$RUNTIME_DIR")
export RVC_DATA_DIR
export PYTHONPATH="$RUNTIME_DIR/src:$RUNTIME_DIR${PYTHONPATH:+:$PYTHONPATH}"
exec "$RVC_DATA_DIR/venv/bin/python" -m rvc_voice_changer "$@"
