#!/usr/bin/env bash
set -uo pipefail

exec 1>&2
export HOME="${HOME:-/root}"
export PATH="${PATH:-/usr/local/sbin:/usr/local/bin:/usr/bin:/bin}"
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib.sh"
ID="linux-rvc-voice-changer"
TITLE="RVC Voice Changer"
GIT_ENV=(GIT_TERMINAL_PROMPT=0 GIT_ASKPASS= GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=15")

log() {
    printf '%s: %s\n' "$ID" "$*"
}

if [[ $EUID -eq 0 ]]; then
    STATE_FILE="${UPDATE_SOURCE_STATE:-/var/lib/$ID/source}"
else
    STATE_FILE="${UPDATE_SOURCE_STATE:-$HOME/.local/state/$ID/source}"
fi
[[ -r $STATE_FILE ]] || exit 0
state_dir=$(dirname "$STATE_FILE")
failed_file="$state_dir/update-failed"
exec 9>"$state_dir/update.lock"
if ! flock -n 9; then
    log "another update is already running, skipping"
    exit 0
fi
mapfile -t state <"$STATE_FILE"
checkout="${state[0]:-}"
owner="${state[1]:-}"
[[ -n $checkout && -n $owner ]] || exit 0
[[ $EUID -eq 0 || $owner == "$(id -un)" ]] || exit 0
uid=$(id -u "$owner" 2>/dev/null) || exit 0
home=$(getent passwd "$owner" | cut -d: -f6)
if [[ $EUID -eq 0 ]]; then
    data_dir="$home/.local/share/Linux-RVC-Voice-Changer"
else
    data_dir="${XDG_DATA_HOME:-$HOME/.local/share}/Linux-RVC-Voice-Changer"
fi
pending="$home/.local/state/$ID/update-pending"
built_file="$state_dir/built-inputs"

as_owner() {
    if [[ $EUID -ne 0 ]]; then
        env "${GIT_ENV[@]}" "$@"
        return
    fi
    runuser -u "$owner" -- env -i HOME="$home" USER="$owner" LOGNAME="$owner" PATH="$home/.local/bin:/usr/local/bin:/usr/bin:/bin" \
        LANG="${LANG:-C.UTF-8}" XDG_RUNTIME_DIR="/run/user/$uid" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
        "${GIT_ENV[@]}" "$@"
}

dependency_versions() {
    if command -v pacman >/dev/null 2>&1; then
        pacman -Q $(pacman_dependency_packages) 2>/dev/null
    elif command -v rpm >/dev/null 2>&1; then
        rpm -q python3 python3-devel gcc pipewire-utils pipewire-pulseaudio wireplumber pulseaudio-utils kf6-kpackage kf6-kdeclarative qt6-qtdeclarative glib2 nvidia-driver 2>&1
    elif command -v dpkg-query >/dev/null 2>&1; then
        dpkg-query -W -f='${binary:Package} ${Version}\n' python3 python3-venv python3-dev gcc pipewire-bin pipewire-pulse wireplumber pulseaudio-utils kpackagetool6 libglib2.0-bin 2>&1
    fi
    python3 -c 'import sys; print("%d.%d.%d" % sys.version_info[:3])' 2>&1
}

dependency_fingerprint() {
    dependency_versions | sort | sha256sum | cut -d' ' -f1
}

git_owner() {
    as_owner git -C "$checkout" "$@"
}

pull_updates() {
    git_owner rev-parse --abbrev-ref '@{upstream}' >/dev/null 2>&1 || return 1
    if ! git_owner fetch --quiet; then
        log "could not fetch updates for $checkout, skipping"
        return 1
    fi
    [[ $(git_owner rev-list --count 'HEAD..@{upstream}') -gt 0 ]] || return 1
    if [[ -n $(git_owner status --porcelain --untracked-files=no) ]]; then
        log "$checkout has local changes, skipping the update"
        return 1
    fi
    if [[ $(git_owner rev-list --count '@{upstream}..HEAD') -gt 0 ]]; then
        log "$checkout has local commits that aren't upstream, skipping the update"
        return 1
    fi
    git_owner merge --ff-only --quiet '@{upstream}' || return 1
    git_owner submodule update --init --recursive --quiet
    log "updated to $(git_owner rev-parse --short HEAD)"
}

runtime_current() {
    local version
    version=$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])') || return 1
    [[ -d $data_dir/venv/lib/python$version && -x $data_dir/runtime/bin/rvc-voice-changer ]]
}

if [[ ${1:-} == --record-built ]]; then
    dependency_fingerprint >"$built_file"
    exit 0
fi
if [[ ! -d $checkout ]]; then
    if [[ -d $home ]]; then
        log "checkout $checkout is gone, removing the $TITLE update hook"
        if [[ $EUID -eq 0 ]]; then
            remove_system_update_files
        else
            remove_user_update_files
        fi
        exit 0
    fi
    log "checkout $checkout is gone and $home is missing, skipping"
    exit 0
fi
if ! git_owner rev-parse --git-dir >/dev/null 2>&1; then
    log "git could not read $checkout, skipping"
    exit 0
fi
fingerprint=$(dependency_fingerprint)
if ! pull_updates && [[ ! -e $pending ]]; then
    if [[ $(cat "$built_file" 2>/dev/null) == "$fingerprint" ]]; then
        runtime_current && exit 0
        log "the $TITLE runtime is missing or built for another Python, rebuilding it"
    else
        log "a package $TITLE depends on changed, rebuilding"
    fi
fi

inputs="$(git_owner rev-parse HEAD) $fingerprint"
if [[ $(cat "$failed_file" 2>/dev/null) == "$inputs" ]]; then
    log "last update failed for these inputs, skipping; run ./install.sh to retry"
    exit 0
fi
status=0
if [[ $EUID -eq 0 ]]; then
    (cd "$checkout" && "$checkout/install.sh" --system-update-root --owner "$owner") || status=1
fi
if [[ $EUID -ne 0 || -S /run/user/$uid/bus ]]; then
    (cd "$checkout" && as_owner "$checkout/install.sh" --system-update) || status=1
else
    as_owner mkdir -p "$(dirname "$pending")"
    as_owner touch "$pending"
    log "$TITLE will finish updating at your next login"
fi
if [[ $status -ne 0 ]]; then
    printf '%s\n' "$inputs" >"$failed_file"
    log "the update failed, it will not be retried until the source or its dependencies change"
else
    rm -f "$failed_file"
    printf '%s\n' "$fingerprint" >"$built_file"
fi
